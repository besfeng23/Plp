{
  "name": "pueblo-la-perla",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/optimize-plp-images.mjs && node scripts/prepare-plp-static-pages.mjs && node scripts/patch-plp-static-policy.mjs && node scripts/check-viewport-fit.mjs && vite build && node scripts/inject-plp-subscription-gate.mjs && node scripts/prepare-plp-react-route-html.mjs",
    "preview": "vite preview",
    "check:routes": "node scripts/audit-plp-routes.mjs",
    "check:viewport": "node scripts/check-viewport-fit.mjs",
    "test": "PLP_SITE_PRIVATE=false PLP_PUBLIC_BOOKINGS_ENABLED=true node --test",
    "verify:db": "bash scripts/verify-db-migrations.sh"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/functions": "3.11.3",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "lucide-react": "1.77.0",
    "posthog-js": "1.450.0"
  },
  "devDependencies": {
    "sharp": "0.35.5",
    "tailwindcss": "3.4.19",
    "postcss": "8.5.33",
    "autoprefixer": "10.7.0"
  }
}
